---
import BaseIcon from './BaseIcon.astro';
import { t, type Locale } from '../../i18n';
import type { CraftBase, ItemState } from '../../lib/crafting';

/**
 * An item, drawn the way a crafter thinks about it: a base, an item level,
 * and two columns of slots. A filled slot says how the modifier got there;
 * an empty one is drawn empty, because the empty slots are what the next
 * step works with.
 */
interface Props {
  state: ItemState;
  base?: CraftBase;
  itemLevel?: number;
  /** Slots per side: 3 for equipment, 2 for jewels, 1 for flasks. */
  slots?: number;
  locale: Locale;
  /** A smaller card, for the state after a step. */
  compact?: boolean;
  caption?: string;
}
const { state, base, itemLevel, slots = 3, locale, compact = false, caption } = Astro.props;
const sides = [
  { key: 'prefixes', list: state.prefixes },
  { key: 'suffixes', list: state.suffixes },
] as const;
// Rarity is how many slots exist at all: a Magic item has one a side, a
// Normal one has none. Drawing three empty slots on a Magic item would teach
// the wrong thing at the exact moment the reader is learning it.
const cap = state.rarity === 'normal' ? 0 : state.rarity === 'magic' ? 1 : slots;
const open = (count: number) => Array.from({ length: Math.max(0, cap - count) });
---
<figure class:list={['item', `item--${state.rarity}`, { 'item--compact': compact }]}>
  {caption && <figcaption class="item__caption">{caption}</figcaption>}
  <div class="item__box">
    <header class="item__head">
      {base && <BaseIcon base={base} cell={compact ? 18 : 24} max={compact ? 54 : 84} />}
      <div>
        {base && <div class="item__name">{base.name}</div>}
        <div class="item__meta">
          <span class="item__rarity">{t(locale, `craft.rarity.${state.rarity}`)}</span>
          {itemLevel && <span>{t(locale, 'craft.ilvl', { n: itemLevel })}</span>}
          {state.note && <span>{state.note}</span>}
        </div>
      </div>
    </header>
    {state.implicits.length > 0 && (
      <ul class="item__implicits">
        {state.implicits.map((line) => <li>{line}</li>)}
      </ul>
    )}
    <div class="item__sides">
      {sides.map((side) => (
        <div class="item__side">
          <div class="item__side-head">
            <span>{t(locale, `craft.${side.key}`)}</span>
            <span class="item__count">{side.list.length}/{cap}</span>
          </div>
          <ul>
            {side.list.map((affix) => (
              <li class="affix" data-how={affix.how}>
                <span class="affix__text">{affix.text}</span>
                {affix.how !== 'rolled' && <span class="affix__how">{t(locale, `craft.how.${affix.how}`)}</span>}
              </li>
            ))}
            {open(side.list.length).map(() => <li class="affix affix--open">{t(locale, 'craft.open')}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</figure>

<style>
  .item { margin: 0; }
  .item__caption { font-size: 0.72rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem; }
  .item__box {
    --rarity: var(--border-strong);
    border: 1px solid var(--border);
    border-top: 3px solid var(--rarity);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }
  .item--magic .item__box { --rarity: var(--accent); }
  .item--rare .item__box { --rarity: var(--rework); }
  .item__head { display: flex; align-items: center; gap: 0.85rem; padding: 0.8rem 1rem; }
  .item__name { font-family: var(--font-display); font-weight: 600; font-size: 1.15rem; line-height: 1.2; }
  .item__meta { display: flex; flex-wrap: wrap; gap: 0.1rem 0.7rem; margin-top: 0.2rem; font-size: 0.8rem; color: var(--text-muted); }
  .item__rarity { color: var(--rarity); font-weight: 600; }
  .item--normal .item__rarity { color: var(--text-muted); }
  .item__implicits { list-style: none; margin: 0; padding: 0.55rem 1rem; border-top: 1px solid var(--border); font-size: 0.86rem; color: var(--text-muted); }
  .item__implicits li { margin: 0; }
  .item__sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 1px solid var(--border); }
  .item__side { padding: 0.7rem 1rem 0.85rem; min-width: 0; }
  .item__side + .item__side { border-left: 1px solid var(--border); }
  .item__side-head { display: flex; justify-content: space-between; gap: 0.5rem; font-size: 0.7rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.45rem; }
  .item__count { font-variant-numeric: tabular-nums; }
  .item__side ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }

  /* One slot. The left edge carries the colour of where the modifier came
     from; a plain rolled modifier has no label, since it is the default. */
  .affix {
    --how: var(--border-strong);
    margin: 0;
    padding: 0.3rem 0.5rem 0.32rem 0.6rem;
    border-left: 3px solid var(--how);
    background: var(--surface-2);
    border-radius: 0 3px 3px 0;
    font-size: 0.86rem;
    line-height: 1.35;
    min-height: 1.95rem;
  }
  .affix__text { display: block; overflow-wrap: anywhere; }
  .affix__how { display: block; margin-top: 0.1rem; font-size: 0.66rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--how); }
  .affix[data-how='rolled'] { --how: var(--text-muted); }
  .affix[data-how='crafted'] { --how: var(--accent); }
  .affix[data-how='fractured'] { --how: var(--rework); }
  .affix[data-how='essence'], .affix[data-how='eldritch'] { --how: var(--mixed); }
  .affix[data-how='veiled'] { --how: var(--term-gem); }
  .affix[data-how='influence'], .affix[data-how='beast'] { --how: var(--term-unique); }
  .affix[data-how='fossil'], .affix[data-how='harvest'] { --how: var(--buff); }
  .affix[data-how='corrupted'] { --how: var(--nerf); }
  .affix--open {
    border: 1px dashed var(--border-strong);
    border-radius: 3px;
    background: transparent;
    color: var(--text-muted);
    font-size: 0.78rem;
    display: flex;
    align-items: center;
  }

  .item--compact .item__head { padding: 0.55rem 0.75rem; gap: 0.6rem; }
  .item--compact .item__name { font-size: 0.98rem; }
  .item--compact .item__side { padding: 0.5rem 0.65rem 0.6rem; }
  .item--compact .affix { font-size: 0.8rem; min-height: 1.7rem; padding: 0.22rem 0.4rem 0.24rem 0.5rem; }
  .item--compact .item__implicits { padding: 0.4rem 0.75rem; font-size: 0.8rem; }

  @media (max-width: 420px) {
    .item__sides { grid-template-columns: minmax(0, 1fr); }
    .item__side + .item__side { border-left: 0; border-top: 1px solid var(--border); }
  }
</style>
