---
import { t, type Locale } from '../../i18n';
import { familyShare, tierWeight, type CraftData, type CraftFamily } from '../../lib/crafting';

/**
 * What a base can roll: every prefix and suffix family, how likely each is,
 * and every tier with the item level it needs. Pick the kind of base and the
 * lists change to that base's pool.
 */
interface Props {
  data: CraftData;
  locale: Locale;
  poolNames: Record<string, string>;
}
const { data, locale, poolNames } = Astro.props;
const pools = data.pools.map((pool) => pool.id);
const sides = [
  { key: 'prefixes', families: data.prefix },
  { key: 'suffixes', families: data.suffix },
] as const;
const percent = (share: number) => (share >= 0.1 ? share.toFixed(0) : share.toFixed(1)) + '%';
// Most likely first, judged on the first pool that can roll the family.
const ordered = (families: CraftFamily[]) =>
  [...families].sort((a, b) => familyShare(families, b, (b.on ?? pools)[0]) - familyShare(families, a, (a.on ?? pools)[0]));
---
<div class="pool" data-mod-pool data-pool={pools[0]}>
  <div class="pool__controls">
    {pools.length > 1 && (
      <div class="pool__chips" role="group" aria-label={t(locale, 'craft.pool.pick')}>
        {pools.map((pool, index) => (
          <button type="button" class:list={['chip', { 'is-active': index === 0 }]} data-pool-pick={pool} aria-pressed={index === 0 ? 'true' : 'false'}>
            {poolNames[pool] ?? pool}
          </button>
        ))}
      </div>
    )}
    <label class="pool__search">
      <span class="visually-hidden">{t(locale, 'craft.pool.search')}</span>
      <input type="search" placeholder={t(locale, 'craft.pool.search')} data-pool-search autocomplete="off" />
    </label>
  </div>

  <div class="pool__sides">
    {sides.map((side) => (
      <section class="pool__side">
        <h3>{t(locale, `craft.${side.key}`)} <span>{side.families.length}</span></h3>
        <p class="pool__legend muted">{t(locale, 'craft.pool.legend')}</p>
        {ordered(side.families).map((family) => (
          <details class="fam" data-family data-pools={(family.on ?? pools).join(' ')}>
            <summary>
              <span class="fam__label">{family.label}</span>
              <span class="fam__best">{t(locale, 'craft.pool.best', { ilvl: family.tiers[0].ilvl })}</span>
              {pools.map((pool) => {
                const share = familyShare(side.families, family, pool) * 100;
                return (
                  <span class="fam__share" data-for-pool={pool} hidden={pool !== pools[0]}>
                    <i style={`width:${Math.min(100, share * 4).toFixed(1)}%`}></i>
                    <b>{percent(share)}</b>
                  </span>
                );
              })}
            </summary>
            <table>
              <tbody>
                {family.tiers.map((tier) => (
                  <tr>
                    <th scope="row">T{tier.tier}</th>
                    <td class="fam__ilvl">{t(locale, 'craft.ilvl.short', { n: tier.ilvl })}</td>
                    <td>{tier.text.map((line) => <span class="fam__line">{line}</span>)}</td>
                    <td class="fam__weight">
                      {typeof tier.weight === 'number'
                        ? tier.weight
                        : pools.map((pool) => <span data-for-pool={pool} hidden={pool !== pools[0]}>{tierWeight(family, tier, pool)}</span>)}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="fam__tags">{family.tags.join(' · ')}</p>
          </details>
        ))}
      </section>
    ))}
  </div>
  <p class="muted" data-pool-empty hidden>{t(locale, 'craft.pool.empty')}</p>
</div>

<script>
  function refresh(root: HTMLElement) {
    const pool = root.dataset.pool ?? '';
    const query = (root.querySelector<HTMLInputElement>('[data-pool-search]')?.value ?? '').trim().toLowerCase();
    let shown = 0;
    for (const family of root.querySelectorAll<HTMLElement>('[data-family]')) {
      const inPool = (family.dataset.pools ?? '').split(' ').includes(pool);
      const matches = query === '' || (family.textContent ?? '').toLowerCase().includes(query);
      family.hidden = !(inPool && matches);
      if (!family.hidden) shown += 1;
    }
    for (const el of root.querySelectorAll<HTMLElement>('[data-for-pool]')) el.hidden = el.dataset.forPool !== pool;
    for (const chip of root.querySelectorAll<HTMLElement>('[data-pool-pick]')) {
      const active = chip.dataset.poolPick === pool;
      chip.classList.toggle('is-active', active);
      chip.setAttribute('aria-pressed', String(active));
    }
    const empty = root.querySelector<HTMLElement>('[data-pool-empty]');
    if (empty) empty.hidden = shown > 0;
  }
  document.addEventListener('click', (event) => {
    const chip = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-pool-pick]') : null;
    const root = chip?.closest<HTMLElement>('[data-mod-pool]');
    if (!chip || !root) return;
    root.dataset.pool = chip.dataset.poolPick;
    refresh(root);
  });
  document.addEventListener('input', (event) => {
    const input = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-pool-search]') : null;
    const root = input?.closest<HTMLElement>('[data-mod-pool]');
    if (root) refresh(root);
  });
  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>('[data-mod-pool]')) refresh(root);
  });
</script>

<style>
  .pool__controls { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.75rem 1.5rem; margin-bottom: 1.5rem; }
  .pool__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .chip {
    font: inherit;
    font-size: 0.82rem;
    font-weight: 500;
    padding: 0.28rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .chip:hover { color: var(--text); border-color: var(--accent); }
  .chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .chip.is-active { background: var(--accent); border-color: var(--accent); color: var(--on-accent); }
  .pool__search input {
    font: inherit;
    font-size: 0.9rem;
    width: min(18rem, 100%);
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
  }
  .pool__sides { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem; align-items: start; }
  .pool__side h3 { display: flex; align-items: baseline; gap: 0.5rem; padding-bottom: 0.5rem; border-bottom: 2px solid var(--text); }
  .pool__side h3 span { font-family: var(--font-body); font-size: 0.8rem; font-weight: 500; color: var(--text-muted); }
  .pool__legend { font-size: 0.8rem; margin: 0.5rem 0 0.4rem; }

  .fam { border-bottom: 1px solid var(--border); }
  .fam summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 5.5rem;
    align-items: center;
    gap: 0.2rem 0.75rem;
    padding: 0.5rem 0;
    cursor: pointer;
    list-style: none;
    font-size: 0.9rem;
  }
  .fam summary::-webkit-details-marker { display: none; }
  .fam summary:hover .fam__label { color: var(--accent); }
  .fam__label { font-weight: 500; }
  .fam__best { font-size: 0.76rem; color: var(--text-muted); white-space: nowrap; }
  /* How likely one random modifier on this side is from this family. The bar
     is scaled so a quarter of the pool fills it. */
  .fam__share { display: grid; grid-template-columns: minmax(0, 1fr) 2.6rem; align-items: center; gap: 0.4rem; }
  .fam__share[hidden] { display: none; }
  .fam__share i { display: block; height: 6px; background: var(--accent); border-radius: 1px; min-width: 1px; justify-self: start; }
  .fam__share b { font-size: 0.76rem; font-weight: 600; font-variant-numeric: tabular-nums; text-align: right; }
  .fam table { width: 100%; border-collapse: collapse; margin: 0.1rem 0 0.4rem; font-size: 0.82rem; }
  .fam th { text-align: left; width: 2.2rem; font-weight: 700; color: var(--text-muted); vertical-align: top; padding: 0.22rem 0; }
  .fam td { padding: 0.22rem 0 0.22rem 0.5rem; vertical-align: top; border-top: 1px solid var(--border); }
  .fam tr:first-child td { border-top: 0; }
  .fam__ilvl { width: 4.2rem; color: var(--text-muted); white-space: nowrap; }
  .fam__weight { width: 3rem; text-align: right; color: var(--text-muted); font-variant-numeric: tabular-nums; }
  .fam__line { display: block; }
  .fam__tags { margin: 0 0 0.6rem; font-size: 0.72rem; color: var(--text-muted); }

  @media (max-width: 900px) {
    .pool__sides { grid-template-columns: minmax(0, 1fr); gap: 2rem; }
  }
  @media (max-width: 480px) {
    .fam summary { grid-template-columns: minmax(0, 1fr) 4.6rem; }
    .fam__best { grid-column: 1; grid-row: 2; }
    .fam__share { grid-row: 1 / span 2; }
  }
</style>
