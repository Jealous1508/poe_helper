---
import type { League } from '../config/leagues';
import { t, type Locale } from '../i18n';
import Donate from './Donate.astro';

interface Props { locale: Locale; league: League }
const { locale, league } = Astro.props;
---
<footer class="site-footer">
  <div class="container">
    <p>{t(locale, 'footer.disclaimer')}</p>
    <p>
      {t(locale, 'footer.sources')}{' '}
      <a href={league.patchNotesUrl} rel="noopener" target="_blank">{t(locale, 'footer.patchNotes', { version: league.id })}</a>
    </p>
    <p class="site-footer__author">{t(locale, 'footer.author')}</p>
    <Donate locale={locale} place="footer" />
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 1.75rem 0 2.25rem;
    font-size: 0.84rem;
    color: var(--text-muted);
  }
  .site-footer p { margin: 0 0 0.4rem; max-width: 52rem; }
  .site-footer__author { color: var(--text); font-weight: 500; margin-top: 0.9rem; }
</style>
