---
// A modal-style popup built on the native Popover API, so it opens and
// closes without any JavaScript. Open it from anywhere with:
//   <button popovertarget="<id>">…</button>
import { t, type Locale } from '../i18n';

interface Props {
  id: string;
  title: string;
  eyebrow?: string;
  locale: Locale;
}
const { id, title, eyebrow, locale } = Astro.props;
---
<div popover id={id} class="popup" role="dialog" aria-labelledby={`${id}-title`}>
  <header class="popup__head">
    <div>
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h3 id={`${id}-title`}>{title}</h3>
    </div>
    <button type="button" class="popup__close" popovertarget={id} popovertargetaction="hide" aria-label={t(locale, 'common.close')}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </header>
  <div class="popup__body">
    <slot />
  </div>
</div>

<style>
  .popup {
    width: min(42rem, calc(100vw - 2rem));
    max-height: min(80vh, 46rem);
    margin: auto;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    background: var(--surface);
    color: var(--text);
    overflow: hidden;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.16s var(--ease), transform 0.16s var(--ease), overlay 0.16s allow-discrete, display 0.16s allow-discrete;
  }
  .popup:popover-open {
    display: flex;
    flex-direction: column;
    opacity: 1;
    transform: none;
  }
  @starting-style {
    .popup:popover-open { opacity: 0; transform: translateY(8px); }
  }
  .popup::backdrop {
    background: var(--backdrop);
    opacity: 0;
    transition: opacity 0.16s var(--ease), overlay 0.16s allow-discrete, display 0.16s allow-discrete;
  }
  .popup:popover-open::backdrop { opacity: 1; }
  @starting-style {
    .popup:popover-open::backdrop { opacity: 0; }
  }
  .popup__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem 0.9rem;
    border-bottom: 1px solid var(--border);
  }
  .popup__head h3 { font-size: 1.25rem; margin-top: 0.15rem; }
  .popup__close {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .popup__close:hover { background: var(--surface-2); color: var(--text); }
  .popup__body { padding: 1.1rem 1.25rem 1.4rem; overflow-y: auto; }
</style>
