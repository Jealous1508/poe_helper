---
import { t, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
---
<button type="button" class="theme-toggle" data-theme-toggle aria-label={t(locale, 'theme.toggle')} title={t(locale, 'theme.toggle')}>
  <svg class="icon icon--sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="12" cy="12" r="4.2" />
    <path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7 7 17M17 7l1.7-1.7" />
  </svg>
  <svg class="icon icon--moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <path d="M20 14.2A8 8 0 0 1 9.8 4a8 8 0 1 0 10.2 10.2Z" />
  </svg>
</button>

<script>
  // One delegated listener survives client-side navigation.
  document.addEventListener('click', (event) => {
    const target = event.target instanceof Element ? event.target.closest('[data-theme-toggle]') : null;
    if (!target) return;
    const root = document.documentElement;
    // Light unless the reader has already switched: the stylesheet does not
    // consult the system preference, so neither does the toggle.
    const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      // Storage can be blocked; the theme still applies for this page view.
    }
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.15s var(--ease), color 0.15s var(--ease);
  }
  .theme-toggle:hover { background: var(--surface-2); color: var(--text); }
  /* Show the icon of the theme you would switch to. */
  .icon--sun { display: none; }
  .icon--moon { display: block; }
  :global(:root[data-theme='dark']) .icon--sun { display: block; }
  :global(:root[data-theme='dark']) .icon--moon { display: none; }
</style>
