---
// Thin bar at the top of the page while a client-side navigation loads.
---
<div class="progress" data-progress aria-hidden="true"></div>

<script>
  let timer: ReturnType<typeof setTimeout> | undefined;
  const bar = () => document.querySelector<HTMLElement>('[data-progress]');

  document.addEventListener('astro:before-preparation', () => {
    // Only show it when loading takes long enough to notice.
    timer = setTimeout(() => bar()?.classList.add('is-loading'), 120);
  });
  document.addEventListener('astro:page-load', () => {
    clearTimeout(timer);
    const el = bar();
    if (!el || !el.classList.contains('is-loading')) return;
    el.classList.add('is-done');
    setTimeout(() => el.classList.remove('is-loading', 'is-done'), 220);
  });
</script>

<style>
  .progress {
    position: fixed;
    inset: 0 0 auto 0;
    height: 2px;
    z-index: 100;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    opacity: 0;
    pointer-events: none;
  }
  .progress:global(.is-loading) {
    opacity: 1;
    transform: scaleX(0.8);
    transition: transform 4s cubic-bezier(0.1, 0.6, 0.2, 1);
  }
  .progress:global(.is-done) {
    transform: scaleX(1);
    opacity: 0;
    transition: transform 0.15s linear, opacity 0.2s linear 0.05s;
  }
</style>
