---
import { renderRich, renderRichInline } from '../lib/rich';
import { getTerms } from '../lib/terms';
import { imageUrl, poedbPage } from '../lib/images';

interface Props {
  text: string;
  league: string;
  /** Content file the text came from, for error messages. */
  where: string;
  inline?: boolean;
  class?: string;
}
const { text, league, where, inline = false, class: className } = Astro.props;
const render = inline ? renderRichInline : renderRich;
// poedb is the reference players already use, and we only link a term
// whose page we have proof of: its icon was downloaded from that page.
const html = render(
  text,
  getTerms(league),
  where,
  (id) => imageUrl(id, where),
  (term) => {
    const page = poedbPage(term.image);
    return page ? `https://poedb.tw/us/${page}` : undefined;
  },
);
const Tag = inline ? 'span' : 'div';
---
<Tag class:list={['rich', className]} set:html={html} />
