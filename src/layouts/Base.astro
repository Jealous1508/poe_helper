---
import '@fontsource-variable/source-serif-4';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgressBar from '../components/ProgressBar.astro';
import type { League } from '../config/leagues';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  league: League;
  title: string;
  description: string;
  section?: 'changelog' | 'builds' | 'leveling';
  /** True when the page shows English content under a non-English URL. */
  isFallback?: boolean;
}
const { locale, league, title, description, section, isFallback = false } = Astro.props;
const fullTitle = `${title} · ${league.name} ${league.id}`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <script is:inline>
      // Apply the saved theme before first paint, and again after each
      // client-side navigation swaps the document.
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem('theme');
            if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <ProgressBar />
    <Header locale={locale} league={league} section={section} />
    {isFallback && (
      <div class="fallback-notice" role="note">
        <div class="container">{t(locale, 'notice.fallback')}</div>
      </div>
    )}
    <main>
      <slot />
    </main>
    <Footer locale={locale} league={league} />
  </body>
</html>

<style>
  .fallback-notice {
    background: var(--accent-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    padding: 0.6rem 0;
  }
</style>
