---
import '@fontsource-variable/source-serif-4';
import '@fontsource/be-vietnam-pro/400.css';
import '@fontsource/be-vietnam-pro/500.css';
import '@fontsource/be-vietnam-pro/600.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProgressBar from '../components/ProgressBar.astro';
import type { League } from '../config/leagues';
import { assetPath, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  league: League;
  title: string;
  description: string;
  section?: 'changelog' | 'builds' | 'leveling';
  /** True when the page shows English content under a non-English URL. */
  isFallback?: boolean;
}
const { locale, league, title, description, section, isFallback = false } = Astro.props;
const fullTitle = `${title} · ${league.name} ${league.id}`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href={assetPath('favicon-64.png')} />
    <link rel="apple-touch-icon" href={assetPath('apple-touch-icon.png')} />
    <meta name="theme-color" content="#0e0f13" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <script is:inline>
      // Apply the saved theme before first paint, and again after each
      // client-side navigation swaps the document.
      (function () {
        function apply() {
          try {
            var saved = localStorage.getItem('theme');
            if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
          } catch (e) {}
        }
        apply();
        document.addEventListener('astro:after-swap', apply);
      })();

      // Scroll reveal and the hero video. Both live in this inline script on
      // purpose: if it runs at all, it both hides and reveals, so content can
      // never be left invisible by a script that failed to load.
      (function () {
        var root = document.documentElement;
        var still = false;
        try {
          still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        } catch (e) {
          still = true;
        }

        function startVideos() {
          var videos = document.querySelectorAll('video[data-src]:not([src])');
          for (var i = 0; i < videos.length; i++) {
            var v = videos[i];
            if (still) continue;
            v.src = v.getAttribute('data-src');
            var p = v.play();
            if (p && p.catch) p.catch(function () {});
          }
        }

        // Set before first paint, otherwise the page paints the elements and
        // then hides them again, which reads as a flicker.
        if (!still) root.setAttribute('data-reveal', 'on');

        function reveal() {
          startVideos();
          var els = document.querySelectorAll('[data-reveal]:not(.is-in)');
          if (still || !window.IntersectionObserver) {
            for (var i = 0; i < els.length; i++) els[i].classList.add('is-in');
            return;
          }
          var io = new IntersectionObserver(
            function (entries) {
              for (var j = 0; j < entries.length; j++) {
                if (entries[j].isIntersecting) {
                  entries[j].target.classList.add('is-in');
                  io.unobserve(entries[j].target);
                }
              }
            },
            { rootMargin: '0px 0px -6% 0px', threshold: 0.04 },
          );
          for (var k = 0; k < els.length; k++) io.observe(els[k]);
        }

        // Keep --header-h in step with the real header, so a header that
        // wraps onto two lines does not cover the sticky bar beneath it.
        function measureHeader() {
          var header = document.querySelector('.site-header');
          if (!header) return;
          var h = header.getBoundingClientRect().height;
          if (h > 0) root.style.setProperty('--header-h', Math.round(h) + 'px');
        }
        var measureTimer;
        window.addEventListener('resize', function () {
          clearTimeout(measureTimer);
          measureTimer = setTimeout(measureHeader, 150);
        });
        document.addEventListener('astro:page-load', measureHeader);

        function safeReveal() {
          measureHeader();
          try {
            reveal();
          } catch (e) {
            // Never leave the page hidden because of a scripting error.
            root.removeAttribute('data-reveal');
          }
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', safeReveal);
        else safeReveal();
        document.addEventListener('astro:page-load', safeReveal);
      })();
    </script>
    <ClientRouter />
  </head>
  <body>
    <ProgressBar />
    <Header locale={locale} league={league} section={section} />
    {isFallback && (
      <div class="fallback-notice" role="note" lang="en">
        <div class="container">{t(locale, 'notice.fallback')}</div>
      </div>
    )}
    {/* On a fallback page the document language is the one the reader asked
        for, but the words are English: say so, or a screen reader will read
        English text with the other language's pronunciation. */}
    <main lang={isFallback ? 'en' : undefined}>
      <slot />
    </main>
    <Footer locale={locale} league={league} />
  </body>
</html>

<style>
  .fallback-notice {
    background: var(--accent-soft);
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
    padding: 0.6rem 0;
  }
</style>
