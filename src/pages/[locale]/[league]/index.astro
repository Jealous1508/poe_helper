---
import Base from '../../../layouts/Base.astro';
import Rich from '../../../components/Rich.astro';
import { getLeague } from '../../../config/leagues';
import { isLocale, pagePath, t } from '../../../i18n';
import { getHome } from '../../../lib/home';
import { leaguePaths } from '../../../lib/paths';

export const getStaticPaths = leaguePaths;

const { locale: rawLocale, league: leagueId } = Astro.params;
if (!isLocale(rawLocale)) throw new Error(`Unknown locale ${rawLocale}`);
const locale = rawLocale;
const league = getLeague(leagueId);
const { home, where, isFallback } = getHome(league.id, locale);
const launch = new Date(`${league.launchDate}T00:00:00Z`).toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const sections = ['changelog', 'builds', 'leveling'] as const;
---
<Base locale={locale} league={league} title={t(locale, 'home.title')} description={home.intro} isFallback={isFallback}>
  <section class="container hero">
    <div class="eyebrow">{t(locale, 'home.eyebrow', { version: league.id })} · {launch}</div>
    <h1>{league.name}</h1>
    <p class="lede">{home.intro}</p>
    <div class="hero__actions">
      <a class="btn" href={pagePath(locale, league.id, 'changelog')}>{t(locale, 'home.cta')}</a>
      <a class="btn btn--ghost" href={league.patchNotesUrl} rel="noopener" target="_blank">{t(locale, 'home.official')}</a>
    </div>
  </section>

  <section class="container">
    <ol class="sections">
      {sections.map((id, index) => (
        <li>
          <a class="section-card" href={pagePath(locale, league.id, id)}>
            <span class="section-card__num">{String(index + 1).padStart(2, '0')}</span>
            <h2>{t(locale, `nav.${id}`)}</h2>
            <p>{t(locale, `home.card.${id}`)}</p>
            <span class="section-card__go">{t(locale, `home.go.${id}`)} →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container highlights">
    <h2>{t(locale, 'home.highlights')}</h2>
    <div class="highlights__grid">
      {home.highlights.map((item) => (
        <article class="highlight">
          <h3>{item.title}</h3>
          <Rich text={item.text} league={league.id} where={where} />
          <a href={pagePath(locale, league.id, item.section)}>{t(locale, `nav.${item.section}`)} →</a>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  .hero { padding-top: 4.5rem; padding-bottom: 3.5rem; }
  .hero h1 { font-size: clamp(2.6rem, 1.6rem + 5vw, 4.6rem); margin: 0.6rem 0 1.1rem; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .sections {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
    overflow: hidden;
  }
  .sections li { margin: 0; }
  .sections li + li { border-left: 1px solid var(--border); }
  .section-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.5rem 1.5rem 1.35rem;
    color: var(--text);
    text-decoration: none;
    transition: background-color 0.15s var(--ease);
  }
  .section-card:hover { background: var(--surface-2); color: var(--text); }
  .section-card__num { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.08em; }
  .section-card h2 { font-size: 1.55rem; margin: 0.5rem 0 0.5rem; }
  .section-card p { color: var(--text-muted); font-size: 0.95rem; flex: 1; }
  .section-card__go { margin-top: 1rem; font-weight: 600; font-size: 0.9rem; color: var(--accent); }

  .highlights { padding-top: 4rem; }
  .highlights__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 1.5rem; }
  .highlight { border-top: 2px solid var(--text); padding-top: 1rem; font-size: 0.97rem; }
  .highlight h3 { margin-bottom: 0.5rem; }
  .highlight a { display: inline-block; margin-top: 0.75rem; font-weight: 600; font-size: 0.9rem; text-decoration: none; }

  @media (max-width: 820px) {
    .sections { grid-template-columns: 1fr; }
    .sections li + li { border-left: 0; border-top: 1px solid var(--border); }
    .highlights__grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .hero { padding-top: 2.75rem; padding-bottom: 2.5rem; }
  }
</style>
