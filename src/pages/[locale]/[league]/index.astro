---
import Base from '../../../layouts/Base.astro';
import Rich from '../../../components/Rich.astro';
import { getLeague } from '../../../config/leagues';
import { assetPath, isLocale, pagePath, t } from '../../../i18n';
import { getHome } from '../../../lib/home';
import { getImage, getMedia, imageUrl } from '../../../lib/images';
import { leaguePaths } from '../../../lib/paths';

export const getStaticPaths = leaguePaths;

const { locale: rawLocale, league: leagueId } = Astro.params;
if (!isLocale(rawLocale)) throw new Error(`Unknown locale ${rawLocale}`);
const locale = rawLocale;
const league = getLeague(leagueId);
const { home, where, isFallback } = getHome(league.id, locale);
const launch = new Date(`${league.launchDate}T00:00:00Z`).toLocaleDateString(locale === 'vi' ? 'vi-VN' : 'en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
const hero = getImage('league-coven-queen', where);
const heroVideo = getMedia('league-hero-video', where);
const sections = [
  { id: 'changelog', image: 'league-atlas' },
  { id: 'builds', image: 'art-pathfinder' },
  { id: 'leveling', image: 'league-grim-fate' },
] as const;
---
<Base locale={locale} league={league} title={t(locale, 'home.title')} description={home.intro} isFallback={isFallback}>
  <section class="hero">
    <div class="hero__media kenburns is-in" aria-hidden="true">
      <video
        class="hero__video"
        poster={assetPath(hero.file)}
        data-src={assetPath(heroVideo.file)}
        width={hero.width}
        height={hero.height}
        muted
        loop
        playsinline
        preload="none"
      ></video>
    </div>
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="eyebrow hero__eyebrow">{t(locale, 'home.eyebrow', { version: league.id })} · {launch}</div>
      <h1>{league.name}</h1>
      <p class="hero__lede">{home.intro}</p>
      <div class="hero__actions">
        <a class="btn" href={pagePath(locale, league.id, 'changelog')}>{t(locale, 'home.cta')}</a>
        <a class="btn btn--on-art" href={league.patchNotesUrl} rel="noopener" target="_blank">{t(locale, 'home.official')}</a>
      </div>
    </div>
  </section>

  <section class="container">
    <ol class="sections">
      {sections.map((section, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <a class="section-card hoverable" href={pagePath(locale, league.id, section.id)}>
            <span class="section-card__art">
              <img src={imageUrl(section.image, where)} alt="" loading="lazy" decoding="async" width="600" height="300" />
            </span>
            <span class="section-card__body">
              <span class="section-card__num">{String(index + 1).padStart(2, '0')}</span>
              <h2>{t(locale, `nav.${section.id}`)}</h2>
              <p>{t(locale, `home.card.${section.id}`)}</p>
              <span class="section-card__go">{t(locale, `home.go.${section.id}`)} →</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="container highlights">
    <h2 data-reveal>{t(locale, 'home.highlights')}</h2>
    <div class="highlights__grid">
      {home.highlights.map((item, index) => (
        <article data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <h3>{item.title}</h3>
          <Rich text={item.text} league={league.id} where={where} />
          <a href={pagePath(locale, league.id, item.section)}>{t(locale, `nav.${item.section}`)} →</a>
        </article>
      ))}
    </div>
  </section>
</Base>

<style>
  /* The hero keeps its dark, cinematic treatment in both themes: the league
     art is almost black, and a light version of it would be unreadable. */
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: min(32rem, 76vh);
    margin-bottom: 3.5rem;
    overflow: hidden;
    background: #07080c;
    border-bottom: 1px solid var(--border);
  }
  .hero__media, .hero__scrim { position: absolute; inset: 0; z-index: -1; }
  .hero__media { overflow: hidden; }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 45%;
    display: block;
  }
  /* Flat scrim, not a gradient, so the text stays readable over the art. */
  .hero__scrim { background: rgb(7 8 12 / 0.52); }
  .hero__inner { padding-top: 7rem; padding-bottom: 3.25rem; color: #f4f3f0; }
  .hero__eyebrow { color: #cfcad9; }
  .hero h1 {
    font-size: clamp(2.8rem, 1.6rem + 5.5vw, 5.2rem);
    margin: 0.5rem 0 1rem;
    color: #fff;
    max-width: 16ch;
  }
  .hero__lede { font-size: 1.12rem; max-width: 46rem; color: #ddd9e4; margin: 0; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.9rem; }
  .btn--on-art {
    background: transparent;
    color: #fff;
    border-color: rgb(255 255 255 / 0.45);
  }
  .btn--on-art:hover { background: rgb(255 255 255 / 0.12); color: #fff; border-color: #fff; }

  .sections {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  .sections li { margin: 0; }
  .section-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .section-card:hover { border-color: var(--accent); color: var(--text); }
  .section-card__art { display: block; aspect-ratio: 16 / 8; overflow: hidden; background: #0c0d12; }
  .section-card__art img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s var(--ease); }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .section-card:hover .section-card__art img { transform: scale(1.05); }
  }
  .section-card__body { display: flex; flex-direction: column; flex: 1; padding: 1.3rem 1.4rem 1.25rem; }
  .section-card__num { font-size: 0.78rem; font-weight: 600; color: var(--text-muted); letter-spacing: 0.08em; }
  .section-card h2 { font-size: 1.5rem; margin: 0.45rem 0 0.5rem; }
  .section-card p { color: var(--text-muted); font-size: 0.95rem; flex: 1; margin: 0; }
  .section-card__go { margin-top: 1.1rem; font-weight: 600; font-size: 0.9rem; color: var(--accent); }

  .highlights { padding-top: 4rem; }
  .highlights__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-top: 1.5rem; }
  .highlights article { border-top: 2px solid var(--text); padding-top: 1rem; font-size: 0.97rem; }
  .highlights h3 { margin-bottom: 0.5rem; }
  .highlights article a { display: inline-block; margin-top: 0.75rem; font-weight: 600; font-size: 0.9rem; text-decoration: none; }

  @media (max-width: 820px) {
    .hero { min-height: 26rem; margin-bottom: 2.5rem; }
    .hero__inner { padding-top: 5rem; padding-bottom: 2.5rem; }
    .sections { grid-template-columns: 1fr; }
    .section-card__art { aspect-ratio: 16 / 6; }
    .highlights__grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
