---
import Base from '../../../../layouts/Base.astro';
import ActTabs from '../../../../components/leveling/ActTabs.astro';
import GameImage from '../../../../components/GameImage.astro';
import Rich from '../../../../components/Rich.astro';
import { getLeague, leagues } from '../../../../config/leagues';
import { isLocale, locales, t } from '../../../../i18n';
import { getLabs, getOverview, hasLabs } from '../../../../lib/leveling';

export function getStaticPaths() {
  return locales.flatMap((locale) =>
    leagues.filter((league) => hasLabs(league.id)).map((league) => ({ params: { locale, league: league.id } })),
  );
}

const { locale: rawLocale, league: leagueId } = Astro.params;
if (!isLocale(rawLocale)) throw new Error(`Unknown locale ${rawLocale}`);
const locale = rawLocale;
const league = getLeague(leagueId);
const found = getLabs(league.id, locale);
if (!found) throw new Error(`leveling/${league.id}: no labs.yaml`);
const { labs: page, isFallback } = found;
const { overview } = getOverview(league.id, locale);
---
<Base locale={locale} league={league} title={t(locale, 'leveling.labs')} description={page.intro} section="leveling" isFallback={isFallback}>
  <div class="container page-head">
    <div class="eyebrow">{t(locale, 'leveling.eyebrow')}</div>
    <h1>{t(locale, 'leveling.labsTitle')}</h1>
    <p class="lede">{page.intro}</p>
  </div>

  <ActTabs stops={overview.stops} current="labs" league={league.id} locale={locale} />

  <div class="container">
    <ol class="labs">
      {page.labs.map((lab, index) => (
        <li class="lab" id={lab.id} data-reveal>
          <header class="lab__head">
            <GameImage id="quest-labyrinth" size={48} where={page.where} />
            <div>
              <div class="eyebrow">{t(locale, 'leveling.labs.number', { n: index + 1 })} · {t(locale, 'leveling.areaLevel', { level: lab.areaLevel })}</div>
              <h2>{lab.name}</h2>
            </div>
          </header>

          <dl class="lab__facts">
            <div><dt>{t(locale, 'leveling.labs.needs')}</dt><dd>{lab.requires}</dd></div>
            <div><dt>{t(locale, 'leveling.labs.when')}</dt><dd><Rich text={lab.when} league={league.id} where={page.where} inline /></dd></div>
            <div><dt>{t(locale, 'leveling.labs.ready')}</dt><dd><Rich text={lab.ready} league={league.id} where={page.where} inline /></dd></div>
            <div><dt>{t(locale, 'leveling.labs.reward')}</dt><dd>{lab.reward}</dd></div>
          </dl>

          <h3>{t(locale, 'leveling.labs.trials')}</h3>
          <ul class="trials">
            {lab.trials.map((trial) => (
              <li>
                <span class="trials__act">{t(locale, 'leveling.act', { number: trial.act })}</span>
                <span class="trials__zone">{trial.zone}</span>
                <span class="trials__trap">{trial.trap}</span>
              </li>
            ))}
          </ul>

          {lab.notes.length > 0 && (
            <ul class="lab__notes">
              {lab.notes.map((note) => <li><Rich text={note} league={league.id} where={page.where} inline /></li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>

    <section class="block">
      <h2>{t(locale, 'leveling.labs.howItWorks')}</h2>
      <div class="cards">
        {page.rules.map((rule) => (
          <article data-reveal>
            <h3>{rule.title}</h3>
            <Rich text={rule.body} league={league.id} where={page.where} />
          </article>
        ))}
      </div>
    </section>

    {page.traps.length > 0 && (
      <section class="block">
        <h2>{t(locale, 'leveling.labs.trapTypes')}</h2>
        <div class="cards cards--tight">
          {page.traps.map((trap) => (
            <article data-reveal>
              <h3>{trap.name}</h3>
              <Rich text={trap.body} league={league.id} where={page.where} />
            </article>
          ))}
        </div>
      </section>
    )}

    {page.sources.length > 0 && (
      <p class="sources muted">
        {t(locale, 'common.sources')}:
        {page.sources.map((source, i) => <>{i > 0 && ' · '}<a href={source.url} rel="noopener" target="_blank">{source.title}</a></>)}
      </p>
    )}
  </div>
</Base>

<style>
  .labs { list-style: none; margin: 2.5rem 0 0; padding: 0; display: grid; gap: 1.25rem; }
  .lab {
    margin: 0;
    padding: 1.4rem 1.5rem 1.5rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface);
    scroll-margin-top: 8rem;
  }
  .lab__head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.1rem; }
  .lab__head h2 { font-size: 1.6rem; margin-top: 0.15rem; }
  .lab__facts { margin: 0 0 1.4rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.85rem 2rem; font-size: 0.95rem; }
  .lab__facts dt, .lab h3 {
    font-family: var(--font-body); font-size: 0.74rem; font-weight: 600;
    letter-spacing: 0.09em; text-transform: uppercase; color: var(--text-muted);
  }
  .lab__facts dd { margin: 0.2rem 0 0; }
  .lab h3 { margin-bottom: 0.5rem; }
  .trials { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; font-size: 0.94rem; }
  .trials li { display: grid; grid-template-columns: 4rem minmax(0, 1fr) minmax(0, 1fr); gap: 1rem; margin: 0; padding: 0.4rem 0; border-top: 1px solid var(--border); }
  .trials__act { color: var(--text-muted); }
  .trials__zone { font-weight: 600; }
  .trials__trap { color: var(--text-muted); }
  .lab__notes { margin: 1.2rem 0 0; font-size: 0.94rem; }

  .block { padding-top: 3rem; }
  .block h2 { margin-bottom: 1.25rem; }
  .cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem 2.25rem; }
  .cards--tight { grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 1.5rem; }
  .cards article { border-top: 2px solid var(--text); padding-top: 0.8rem; font-size: 0.95rem; }
  .cards h3 { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -0.01em; text-transform: none; color: var(--text); margin-bottom: 0.4rem; }
  .sources { margin-top: 3rem; font-size: 0.84rem; }

  @media (max-width: 820px) {
    .lab__facts { grid-template-columns: 1fr; }
    .trials li { grid-template-columns: 1fr; gap: 0.1rem; }
    .cards { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
