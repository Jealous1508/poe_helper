---
import Base from '../../../../layouts/Base.astro';
import Rich from '../../../../components/Rich.astro';
import BaseIcon from '../../../../components/crafting/BaseIcon.astro';
import Level from '../../../../components/crafting/Level.astro';
import { getLeague } from '../../../../config/leagues';
import { isLocale, pagePath, t } from '../../../../i18n';
import { craftGroups, examplesOf, getCraftData, getCrafting } from '../../../../lib/crafting';
import { leaguePaths } from '../../../../lib/paths';

export const getStaticPaths = leaguePaths;

const { locale: rawLocale, league: leagueId } = Astro.params;
if (!isLocale(rawLocale)) throw new Error(`Unknown locale ${rawLocale}`);
const locale = rawLocale;
const league = getLeague(leagueId);
const crafting = getCrafting(league.id, locale);
const howHref = pagePath(locale, league.id, 'crafting', 'how-it-works');
const groups = craftGroups
  .map((group) => ({ group, guides: (crafting?.guides ?? []).filter((guide) => guide.group === group) }))
  .filter((entry) => entry.guides.length > 0);
const start = crafting
  ? [
      { href: `${howHref}#anatomy`, title: t(locale, 'craft.start.anatomy'), text: t(locale, 'craft.start.anatomy.text'), n: crafting.overview.anatomy.length },
      { href: `${howHref}#toolbox`, title: t(locale, 'craft.start.toolbox'), text: t(locale, 'craft.start.toolbox.text'), n: crafting.overview.methods.length },
      { href: `${howHref}#memory-strands`, title: t(locale, 'craft.section.strands'), text: t(locale, 'craft.start.strands.text'), n: crafting.overview.memoryStrands.rules.length },
    ]
  : [];
const isFallback = Boolean(crafting && (crafting.overviewIsFallback || crafting.guides.some((guide) => guide.isFallback)));
---
<Base locale={locale} league={league} title={t(locale, 'craft.title')} description={t(locale, 'craft.lede')} section="crafting" isFallback={isFallback}>
  <div class="container page-head">
    <div class="eyebrow">{t(locale, 'changelog.eyebrow', { version: league.id })}{crafting && ` · ${t(locale, 'common.verified')} ${crafting.overview.verified}`}</div>
    <h1>{t(locale, 'craft.title')}</h1>
    {crafting ? <Rich text={crafting.overview.intro} league={league.id} where={crafting.overview.where} class="lede" /> : <p class="lede">{t(locale, 'craft.lede')}</p>}
  </div>

  {!crafting ? (
    <div class="container"><p class="muted">{t(locale, 'craft.none')}</p></div>
  ) : (
    <>
      <section class="container start">
        <h2>{t(locale, 'craft.start')}</h2>
        <ol>
          {start.map((card, index) => (
            <li data-reveal style={`--reveal-delay:${index * 80}ms`}>
              <a class="hoverable" href={card.href}>
                <span class="start__n">{String(index + 1).padStart(2, '0')}</span>
                <strong>{card.title}</strong>
                <span>{card.text}</span>
              </a>
            </li>
          ))}
        </ol>
        <div class="scope">
          <h3>{t(locale, 'craft.scope')}</h3>
          <Rich text={crafting.overview.scope} league={league.id} where={crafting.overview.where} />
        </div>
      </section>

      <div class="container">
        <h2 class="pick">{t(locale, 'craft.pick')}</h2>
        <p class="muted pick__note">{t(locale, 'craft.pick.note')}</p>
        {groups.map(({ group, guides }) => (
          <section class="group" id={`group-${group}`}>
            <h3>{t(locale, `craft.group.${group}`)} <span>{guides.length}</span></h3>
            <ul class="cats">
              {guides.map((guide) => {
                const data = getCraftData(guide.id);
                const examples = examplesOf(crafting, guide.id);
                const hardest = Math.max(0, ...examples.map((example) => example.level));
                return (
                  <li data-reveal>
                    <a class="cat hoverable" href={pagePath(locale, league.id, 'crafting', guide.id)}>
                      <span class="cat__icon"><BaseIcon base={data.bases.find((base) => base.name === guide.icon)!} cell={22} max={76} /></span>
                      <span class="cat__body">
                        <strong>{guide.name}</strong>
                        <span class="cat__short">{guide.short}</span>
                        <span class="cat__meta">
                          <span>{t(locale, 'craft.bases.count', { count: data.bases.length })}</span>
                          <span>{t(locale, 'craft.examples.count', { count: examples.length })}</span>
                          {hardest > 0 && <Level level={hardest} locale={locale} quiet />}
                        </span>
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
    </>
  )}
</Base>

<style>
  .page-head :global(.lede) { max-width: var(--measure); }
  .start h2, .pick { padding-bottom: 0.55rem; border-bottom: 2px solid var(--text); }
  .start ol { list-style: none; margin: 1.25rem 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .start li { margin: 0; }
  .start li a { display: grid; gap: 0.3rem; height: 100%; padding: 1.1rem 1.25rem 1.2rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); text-decoration: none; }
  .start li a:hover { border-color: var(--accent); }
  .start__n { font-size: 0.78rem; font-weight: 600; letter-spacing: 0.08em; color: var(--text-muted); }
  .start li strong { font-family: var(--font-display); font-size: 1.3rem; }
  .start li a > span:last-child { font-size: 0.92rem; color: var(--text-muted); }
  .scope { max-width: var(--measure); margin-top: 1.75rem; padding: 0.2rem 0 0.2rem 1.1rem; border-left: 3px solid var(--accent); }
  .scope h3 { font-family: var(--font-body); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.09em; text-transform: uppercase; color: var(--accent); margin: 0 0 0.45rem; }

  .pick { margin-top: 3.5rem; }
  .pick__note { max-width: var(--measure); margin-top: 0.8rem; }
  .group { padding-top: 2rem; }
  .group h3 { display: flex; align-items: baseline; gap: 0.5rem; margin-bottom: 0.9rem; }
  .group h3 span { font-family: var(--font-body); font-size: 0.82rem; font-weight: 500; color: var(--text-muted); }
  .cats { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(18.5rem, 1fr)); gap: 1rem; }
  .cats li { margin: 0; }
  .cat { display: grid; grid-template-columns: 4.6rem minmax(0, 1fr); gap: 0.9rem; align-items: center; height: 100%; padding: 0.9rem 1.1rem 0.9rem 0.6rem; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); text-decoration: none; }
  .cat:hover { border-color: var(--accent); color: var(--text); }
  .cat__icon { display: flex; align-items: center; justify-content: center; min-height: 4.75rem; }
  .cat__body { display: grid; gap: 0.2rem; }
  .cat strong { font-family: var(--font-display); font-size: 1.15rem; }
  .cat__short { font-size: 0.86rem; color: var(--text-muted); }
  .cat__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.2rem 0.8rem; margin-top: 0.3rem; font-size: 0.76rem; color: var(--text-muted); }

  @media (max-width: 820px) {
    .start ol { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .cats { grid-template-columns: minmax(0, 1fr); }
  }
</style>
